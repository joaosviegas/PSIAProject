# Copy this file to .env and change every value before running.
# Never commit .env to git.

# Postgres admin password (used only by the postgres container itself)
POSTGRES_ADMIN_PASSWORD=change_me_admin

# Per-service DB passwords (must match infra/postgres/init/)
AUTH_DB_PASSWORD=change_me_auth
PROFILE_DB_PASSWORD=change_me_profile
MOVIES_DB_PASSWORD=change_me_movies

# JWT signing secret — at least 32 characters, random
JWT_SECRET=change_me_this_must_be_at_least_32_chars

# Grafana admin password (login: admin)
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# Optional overrides (defaults shown)
# JWT_TTL_MINUTES=120
# LLM_MODEL=qwen2.5:1.5b
# LLM_TIMEOUT_SECONDS=180
# AGENT_INTERVAL_SECONDS=120
# FEED_TTL_HOURS=24
# GATEWAY_PORT=8080
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
